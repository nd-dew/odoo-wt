# 🎨 stylesheet.tcss

/* Shared */
Screen {
    align: center middle;
    background: transparent;
}

.title {
    text-align: left;
    text-style: bold;
    margin: 0 0 1 0;
    height: auto;
}

.description {
    text-align: left;
    margin-bottom: 0;
    height: auto;
    width: 100%;
    color: $text-muted;
}

.tab-description {
    margin: 1 0;
    color: $text-muted;
    text-style: italic;
    height: auto;
    width: 100%;
}

.btn-row {
    align: center middle;
    margin-top: 1;
    height: auto;
}

Button {
    margin: 0 1;
}

/* Wizard */
#wizard-dialog {
    width: 100%;
    height: 100%;
    margin: 1 4;
    padding: 1 2;
    border: thick white;
    background: $surface;
}

#wizard-dialog .title {
    text-align: center;
    color: white;
}

.req {
    margin-bottom: 0;
    text-align: left;
    width: 100%;
    height: auto;
    color: $text-muted;
}

.tree-box {
    background: $boost;
    padding: 1 2;
    margin-bottom: 0;
    border-left: thick white;
    height: auto;
    width: 100%;
}

.step-title {
    text-style: bold;
    margin-top: 1;
}

.step-desc {
    color: $text-muted;
    margin-bottom: 1;
    height: auto;
    width: 100%;
}

#scanner-status {
    margin: 1 0;
    text-align: center;
}

#scanner-progress {
    margin: 1 0;
}

/* Main App */
#dialog {
    width: 100%;
    height: 100%;
    margin: 1 4;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

#dialog .title {
    color: $text-muted;
}

.main-row {
    height: auto;
    margin: 1 0;
    align: center middle;
}

.dash {
    padding: 1 0;
    color: $text-muted;
    text-style: bold;
}

#version-col { width: 2fr; height: auto; }
#desc-col { width: 3fr; height: auto; }
#suffix-col { width: 2fr; height: auto; }

.custom-field {
    display: none;
    margin-top: 0;
    border: solid $accent;
}

.custom-field.visible {
    display: block;
}

.info-box {
    background: $boost;
    padding: 1 2;
    margin: 1 0;
    border-left: thick $accent;
    height: auto;
}

.summary-box {
    background: $surface-lighten-1;
    padding: 1 2;
    margin: 1 0;
    border-left: thick $success;
    height: auto;
    width: 100%;
}

DataTable {
    height: 1fr;
    margin: 1 0;
    border: solid $accent;
}

Tab {
    padding: 0 3;
}

/* Settings */
.settings-container {
    padding: 0 1;
    height: auto;
}

.setting-item {
    height: 3;
    margin-bottom: 0;
    align: left middle;
}

.setting-label {
    width: 22;
    height: 3;
    content-align: left middle;
    color: white;
    text-style: bold;
}

.setting-input {
    width: 1fr;
    height: 3;
}

/* Screens */
DeleteConfirmScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#delete-dialog {
    width: 50;
    height: auto;
    padding: 2 4;
    border: thick $error;
    background: $surface;
}

.del-btn-row {
    align: center middle;
    margin-top: 1;
    height: 3;
}

#del-msg {
    text-align: center;
    text-style: bold;
    color: $error;
    width: 100%;
    margin-bottom: 1;
}



DeployScreen {
    padding: 1 2;
}

.deploy-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}



.log-box {
    height: 15;
    width: 1fr;
    border: solid $surface;
}

.log-title {
    text-style: bold;
    background: $boost;
    padding: 0 1;
}

#prog-odoo, #prog-ent, #prog-uv {
    margin-bottom: 1;
}

LogDetailScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#log-detail-dialog {
    width: 80;
    height: auto;
    max-height: 80vh;
    padding: 2 4;
    border: thick $accent;
    background: $surface;
}

.log-detail-title {
    text-align: left;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.log-detail-text {
    margin-bottom: 1;
}

.log-detail-btn-row {
    align: center middle;
    margin-top: 1;
    height: 3;
}

#top-bar {
    width: 100%;
    height: auto;
    layout: horizontal;
}

#title-container {
    width: 1fr;
    height: auto;
}

.close-btn {
    min-width: 5;
    width: 5;
    height: 3;
    border: none;
    background: transparent;
    color: $error;
    text-style: bold;
}
.close-btn:hover {
    background: $error-muted;
}

.textual-toast {
    background: $surface;
    color: $text-muted;
    border: none;
    padding: 1 2;
    max-width: 40;
}

#success-footer {
    height: auto;
    padding: 1 2;
    margin-top: 1;
    background: $boost;
    border-top: thick $success;
}

#success-footer.hidden {
    display: none;
}

.strategy-desc {
    color: $text-muted;
    height: auto;
    width: 100%;
    margin: 1 0 0 0;
}
