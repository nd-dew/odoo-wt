# 🎨 stylesheet.tcss

/* Shared */
Screen {
    align: center top;
    background: transparent;
}

.title {
    text-align: left;
    text-style: bold;
    margin: 0 0 1 0;
    height: auto;
}

.description {
    text-align: left;
    margin-bottom: 0;
    height: auto;
    width: 100%;
    color: $text-muted;
}

.tab-description {
    margin: 1 0;
    color: $text-muted;
    text-style: italic;
    height: auto;
    width: 100%;
}

.btn-row {
    align: center middle;
    margin-top: 1;
    height: auto;
}

Button {
    margin: 0 1;
}

#preflight-banner {
    background: $error-muted;
    color: $error;
    padding: 1;
    margin: 1 0;
    border: solid $error;
    height: auto;
    width: 100%;
}

/* Wizard */
#wizard-scroll {
    width: 100%;
    height: 100%;
    margin: 1 1;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#wizard-dialog {
    width: 100%;
    height: auto;
}

#final-steps {
    height: auto;
}

#wizard-dialog .title {
    text-align: center;
    color: $text;
}

.req {
    margin-bottom: 0;
    text-align: left;
    width: 100%;
    height: auto;
    color: $text-muted;
}

.tree-box {
    background: $boost;
    padding: 1 2;
    margin-bottom: 0;
    border-left: thick;
    height: auto;
    width: 100%;
}

.step-title {
    text-style: bold;
    margin-top: 1;
}

.step-desc {
    color: $text-muted;
    margin-bottom: 1;
    height: auto;
    width: 100%;
}

#scanner-status {
    margin: 1 0;
    text-align: center;
}

#scanner-progress {
    margin: 1 0;
}



/* Main App */
#dialog {
    width: 100%;
    height: 100%;
    margin: 1 1;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#dialog .title {
    color: $text-muted;
}

.main-row {
    height: auto;
    margin: 1 0;
    align: center middle;
}

.dash {
    padding: 1 0;
    color: $text-muted;
    text-style: bold;
}

#version-col { width: 25; height: auto; }
#desc-col { width: 1fr; height: auto; }
#suffix-col { width: 25; height: auto; }

.select-row {
    height: auto;
    width: 100%;
}

.select-row Select {
    width: 1fr;
}

.rm-btn {
    min-width: 3;
    width: 3;
    height: 3;
    padding: 0;
    margin: 0 0 0 1;
    background: $error-muted;
    color: white;
}

.rm-btn:hover {
    background: $error;
}

.custom-field {
    display: none;
    margin-top: 0;
    border: solid $accent;
}

.custom-field.visible {
    display: block;
}

.info-box {
    background: $boost;
    padding: 1 2;
    margin: 1 0;
    border-left: thick $accent;
    height: auto;
}

.summary-box {
    background: $surface-lighten-1;
    padding: 1 2;
    margin: 1 0;
    border-left: thick $success;
    height: auto;
    width: 100%;
}

DataTable {
    height: 1fr;
    margin: 1 0;
    border: solid $accent;
}

Tab {
    padding: 0 3;
}

#tab-settings {
    overflow: hidden hidden;
}

/* Settings */
.settings-container {
    padding: 1 2;
    height: 1fr;
}

.setting-item {
    height: 3;
    margin-bottom: 0;
    align: left middle;
}

.setting-item.full-width {
    height: auto;
    margin-bottom: 1;
}

.setting-label {
    width: 25;
    height: 3;
    content-align: right middle;
    margin-right: 2;
    color: $text;
}

.setting-input {
    width: 1fr;
    height: 3;
}

/* Toggles should not stretch */
Switch.setting-input, Checkbox.setting-input {
    width: auto;
    margin-right: 2;
}

.help-bar {
    dock: bottom;
    width: 100%;
    height: 2;
    content-align: center middle;
    background: $boost;
    color: $text-muted;
}

/* Screens */
DeleteConfirmScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#delete-dialog {
    width: 50;
    height: auto;
    padding: 2 4;
    border: thick $error;
    background: $surface;
}

.del-btn-row {
    align: center middle;
    margin-top: 1;
    height: 3;
}

#del-msg {
    text-align: center;
    text-style: bold;
    color: $error;
    width: 100%;
    margin-bottom: 1;
}









.log-box {
    height: 1fr;
    min-height: 10;
    width: 1fr;
    border: solid $surface;
}

.log-uv-box {
    height: auto;
    max-height: 8;
    width: 1fr;
    border: solid $surface;
}

.log-header {
    height: 3;
    width: 100%;
    align: left middle;
    background: $boost;
    padding: 0 1;
}

.log-title {
    text-style: bold;
    width: 15;
}

#prog-odoo, #prog-ent, #prog-uv {
    width: 1fr;
}

LogDetailScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#log-detail-dialog {
    width: 80;
    height: auto;
    max-height: 80vh;
    padding: 2 4;
    border: thick $accent;
    background: $surface;
}

.log-detail-title {
    text-align: left;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.log-detail-text {
    margin-bottom: 1;
}

.log-detail-btn-row {
    align: center middle;
    margin-top: 1;
    height: 3;
}

.manage-top-row {
    height: 3;
    margin-bottom: 1;
}

.manage-top-row .search-input {
    width: 1fr;
    margin-right: 1;
}

.manage-top-row .mini-btn {
    min-width: 10;
    margin-left: 1;
}

.settings-top-row {
    height: 3;
    margin-bottom: 1;
}

.settings-top-row .search-input {
    width: 1fr;
    margin-right: 1;
}

.settings-top-row .mini-btn {
    min-width: 12;
    margin-left: 1;
}

.mini-btn {
    height: 3;
    min-width: 15;
    background: $boost;
    color: $accent;
    border: none;
    margin: 0;
}

.mini-btn:hover {
    background: $accent;
    color: white;
}

.magic-flash {
    background: $success-muted;
    color: white;
}

#top-bar {
    width: 100%;
    height: auto;
    layout: horizontal;
}

#title-container {
    width: 1fr;
    height: auto;
}

.close-btn {
    min-width: 5;
    width: 5;
    height: 3;
    border: none;
    background: transparent;
    color: $error;
    text-style: bold;
}
.close-btn:hover {
    background: $error-muted;
}

.textual-toast {
    background: $surface;
    color: $text-muted;
    border: none;
    padding: 1 2;
    max-width: 40;
}

#success-footer {
    height: auto;
    padding: 1 2;
    margin-top: 1;
    background: $boost;
    border-top: thick $success;
}

.hidden {
    display: none;
}

#success-footer.hidden {
    display: none;
}

.strategy-desc {
    color: $text-muted;
    height: auto;
    width: 100%;
    margin: 1 0 0 0;
}

#deploy-logs-scroll {
    height: 1fr;
}

#success-footer .success-msg {
    margin-bottom: 0;
    text-align: left;
}

#success-footer .success-btn-row {
    margin-top: 0;
    height: 3;
    align: left middle;
}

#root-status-label {
    margin: 1 0;
    height: auto;
    text-align: left;
    width: 100%;
}
